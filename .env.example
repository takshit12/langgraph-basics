# Copy to .env and fill in. Only needed for the LLM-backed paths
# (simple_graph.py's search branch, memory_demo.py's replies, the Studio storyteller,
# and the two LangSmith demos, which require it).
# Every core example still runs without a key (canned fallbacks).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: only for the LangSmith demos (langsmith-simple.py, agent-eval.py).
# Get a free key at https://smith.langchain.com -> Settings -> API Keys.
# Without it those files still RUN; they just don't upload traces/evals.
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=""
