# Optional: gives the Studio storyteller a REAL AI-written story (via OpenRouter).
# Without a key the graph still runs — it just uses a short canned scene.
# To enable it, copy this file to .env and fill in your key:
#   cp .env.example .env
OPENROUTER_API_KEY=
# Optional: override the model used for the story.
OPENROUTER_MODEL=openai/gpt-4o-mini
